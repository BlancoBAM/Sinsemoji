#!/usr/bin/env bash
# ==============================================================================
# Sinsemoji Launcher — Lilith Linux Distro Edition
#
# Upstream Application: Simplemoji by Sergio Ribera
# Website: https://github.com/SergioRibera/Simplemoji
#
# Pre-configured Theme Profile:
#   Background Color: Pure Dark Black (#000000)
#   Accent / Primary Color: Lilith Magenta/Purple (#a832a6)
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -n "${SIMPLEMOJI_BIN:-}" ] && [ -x "$SIMPLEMOJI_BIN" ]; then
    EXEC_BIN="$SIMPLEMOJI_BIN"
elif [ -x "$SCRIPT_DIR/simplemoji" ]; then
    EXEC_BIN="$SCRIPT_DIR/simplemoji"
elif [ -x "/usr/bin/simplemoji" ]; then
    EXEC_BIN="/usr/bin/simplemoji"
elif [ -x "/usr/local/bin/simplemoji" ]; then
    EXEC_BIN="/usr/local/bin/simplemoji"
elif command -v simplemoji >/dev/null 2>&1; then
    EXEC_BIN="$(command -v simplemoji)"
elif [ -x "$HOME/.local/bin/simplemoji" ]; then
    EXEC_BIN="$HOME/.local/bin/simplemoji"
elif [ -x "$HOME/.cargo/bin/simplemoji" ]; then
    EXEC_BIN="$HOME/.cargo/bin/simplemoji"
else
    echo "Error: simplemoji upstream binary not found." >&2
    echo "Please ensure simplemoji is installed or available in PATH." >&2
    exit 1
fi

exec "$EXEC_BIN" -b "#000000" -m "#a832a6" "$@"
