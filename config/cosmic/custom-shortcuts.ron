// COSMIC Desktop Custom Shortcut snippet for Sinsemoji
// Install location for user profile:
//   ~/.config/cosmic/com.system76.CosmicSettings.Shortcuts/v1/custom
// Or distro default user skeleton:
//   /etc/skel/.config/cosmic/com.system76.CosmicSettings.Shortcuts/v1/custom

{
    (
        modifiers: [
            Ctrl,
        ],
        key: "e",
        description: Some("Sinsemoji"),
    ): Spawn("sinsemoji"),
    (
        modifiers: [
            Alt,
        ],
        key: "e",
        description: Some("Sinsemoji (Alt+e fallback)"),
    ): Spawn("sinsemoji"),
}
